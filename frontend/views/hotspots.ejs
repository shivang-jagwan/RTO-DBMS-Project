<div class="row">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/analytics">Analytics</a></li>
                <li class="breadcrumb-item active">Hotspots</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-2">
                    <i class="fas fa-map-marker-alt text-warning"></i> Violation Hotspots
                </h1>
                <p class="text-muted mb-0">Locations with high traffic violation concentrations</p>
            </div>
        </div>
    </div>
</div>

<!-- Parameters Form -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-sliders-h"></i> Clustering Parameters
                </h5>
            </div>
            <div class="card-body">
                <form method="GET" action="/analytics/hotspots" class="row g-3">
                    <div class="col-md-4">
                        <label for="eps" class="form-label">
                            Epsilon (ε) - Neighborhood Distance
                            <i class="fas fa-info-circle text-muted" data-bs-toggle="tooltip"
                               title="Maximum distance between two samples for one to be considered as in the neighborhood of the other"></i>
                        </label>
                        <input type="range" class="form-range" id="eps" name="eps"
                               min="0.01" max="1.0" step="0.01" value="<%= params.eps %>">
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">0.01</small>
                            <span class="fw-bold"><%= params.eps %></span>
                            <small class="text-muted">1.0</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label for="min_samples" class="form-label">
                            Minimum Samples
                            <i class="fas fa-info-circle text-muted" data-bs-toggle="tooltip"
                               title="The number of samples in a neighborhood for a point to be considered as a core point"></i>
                        </label>
                        <input type="range" class="form-range" id="min_samples" name="min_samples"
                               min="2" max="20" step="1" value="<%= params.min_samples %>">
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">2</small>
                            <span class="fw-bold"><%= params.min_samples %></span>
                            <small class="text-muted">20</small>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search"></i> Recalculate Hotspots
                        </button>
                    </div>
                </form>
                <div class="mt-3">
                    <small class="text-muted">
                        <strong>DBSCAN Algorithm:</strong> Groups locations based on density. Lower ε = tighter clusters,
                        higher min_samples = denser clusters required.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hotspots Statistics -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-warning text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total Hotspots</h6>
                        <h2 class="mb-0"><%= hotspots.length %></h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-map-marker-alt fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Max Violations</h6>
                        <h2 class="mb-0"><%= hotspots.length > 0 ? Math.max(...hotspots.map(h => h.count)) : 0 %></h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-exclamation-triangle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Avg Violations</h6>
                        <h2 class="mb-0"><%= hotspots.length > 0 ? Math.round(hotspots.reduce((sum, h) => sum + h.count, 0) / hotspots.length) : 0 %></h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-calculator fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hotspots Table -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Detected Hotspots</h5>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="exportHotspots()">
                        <i class="fas fa-download"></i> Export CSV
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="viewMap()">
                        <i class="fas fa-map"></i> View Map
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="hotspotsTable">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Location</th>
                                <th>Violation Count</th>
                                <th>Percentage</th>
                                <th>Risk Level</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% hotspots.forEach((hotspot, index) => { %>
                                <% const totalViolations = hotspots.reduce((sum, h) => sum + h.count, 0); %>
                                <% const percentage = ((hotspot.count / totalViolations) * 100).toFixed(1); %>
                                <tr>
                                    <td>
                                        <span class="badge bg-primary">#<%= index + 1 %></span>
                                    </td>
                                    <td>
                                        <strong><%= hotspot.location %></strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger fs-6"><%= hotspot.count %></span>
                                    </td>
                                    <td>
                                        <div class="progress" style="width: 100px;">
                                            <div class="progress-bar bg-warning" role="progressbar"
                                                 style="width: <%= percentage %>%">
                                                <%= percentage %>%
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (hotspot.count >= 100) { %>
                                            <span class="badge bg-danger">Critical</span>
                                        <% } else if (hotspot.count >= 50) { %>
                                            <span class="badge bg-warning">High</span>
                                        <% } else if (hotspot.count >= 25) { %>
                                            <span class="badge bg-orange">Medium</span>
                                        <% } else { %>
                                            <span class="badge bg-info">Low</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" onclick="viewLocationDetails('<%= hotspot.location %>')">
                                            <i class="fas fa-eye"></i> Details
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hotspots Visualization -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar text-success"></i> Hotspots Distribution
                </h5>
            </div>
            <div class="card-body">
                <canvas id="hotspotsChart" width="800" height="400"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    // Chart data
    const hotspotsChartData = {
        labels: <%- JSON.stringify(hotspots.map(h => h.location)) %>,
        data: <%- JSON.stringify(hotspots.map(h => h.count)) %>
    };

    // Initialize chart
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('hotspotsChart');
        if (ctx && typeof Chart !== 'undefined') {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: hotspotsChartData.labels,
                    datasets: [{
                        label: 'Violation Count',
                        data: hotspotsChartData.data,
                        backgroundColor: 'rgba(255, 193, 7, 0.6)',
                        borderColor: 'rgba(255, 193, 7, 1)',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Number of Violations'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Location'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }
    });

    function exportHotspots() {
        const hotspots = <%- JSON.stringify(hotspots) %>;
        const csvContent = [
            ['Rank', 'Location', 'Violation Count', 'Risk Level'].join(','),
            ...hotspots.map((h, i) => {
                let riskLevel = 'Low';
                if (h.count >= 100) riskLevel = 'Critical';
                else if (h.count >= 50) riskLevel = 'High';
                else if (h.count >= 25) riskLevel = 'Medium';
                return [i + 1, `"${h.location}"`, h.count, riskLevel].join(',');
            })
        ].join('\n');

        const blob = new Blob([csvContent], { type: 'text/csv' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'traffic_hotspots.csv';
        a.click();
        window.URL.revokeObjectURL(url);
    }

    function viewMap() {
        alert('Map visualization would be implemented here. In a production app, you might integrate with Google Maps or Mapbox.');
    }

    function viewLocationDetails(location) {
        // Redirect to violations page filtered by location
        window.location.href = `/violations?location=${encodeURIComponent(location)}`;
    }

    // Update range value displays
    document.getElementById('eps').addEventListener('input', function() {
        this.nextElementSibling.querySelector('.fw-bold').textContent = this.value;
    });

    document.getElementById('min_samples').addEventListener('input', function() {
        this.nextElementSibling.querySelector('.fw-bold').textContent = this.value;
    });
</script>
