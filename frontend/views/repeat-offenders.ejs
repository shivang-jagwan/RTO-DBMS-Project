<div class="row">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/analytics">Analytics</a></li>
                <li class="breadcrumb-item active">Repeat Offenders</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-2">
                    <i class="fas fa-user-times text-danger"></i> Repeat Offenders
                </h1>
                <p class="text-muted mb-0">Drivers with multiple traffic violations</p>
            </div>
        </div>
    </div>
</div>

<!-- Parameters Form -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-sliders-h"></i> Analysis Parameters
                </h5>
            </div>
            <div class="card-body">
                <form method="GET" action="/analytics/repeat-offenders" class="row g-3">
                    <div class="col-md-6">
                        <label for="min_violations" class="form-label">
                            Minimum Violations Threshold
                            <i class="fas fa-info-circle text-muted" data-bs-toggle="tooltip"
                               title="Only show drivers with at least this many violations"></i>
                        </label>
                        <input type="range" class="form-range" id="min_violations" name="min_violations"
                               min="2" max="10" step="1" value="<%= minViolations %>">
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">2</small>
                            <span class="fw-bold"><%= minViolations %></span>
                            <small class="text-muted">10</small>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search"></i> Update Analysis
                        </button>
                    </div>
                </form>
                <div class="mt-3">
                    <small class="text-muted">
                        <strong>Note:</strong> This analysis is based on driver license numbers.
                        Only drivers with <%= minViolations %> or more violations are shown.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Offenders Statistics -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-danger text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total Offenders</h6>
                        <h2 class="mb-0"><%= repeatOffenders.length %></h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-users fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Most Violations</h6>
                        <h2 class="mb-0"><%= repeatOffenders.length > 0 ? Math.max(...repeatOffenders.map(o => o.violation_count)) : 0 %></h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-exclamation-triangle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total Fines</h6>
                        <h2 class="mb-0">₹<%= repeatOffenders.reduce((sum, o) => sum + o.total_fines, 0).toLocaleString() %></h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-rupee-sign fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-secondary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Avg Violations</h6>
                        <h2 class="mb-0"><%= repeatOffenders.length > 0 ? Math.round(repeatOffenders.reduce((sum, o) => sum + o.violation_count, 0) / repeatOffenders.length) : 0 %></h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-calculator fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Repeat Offenders Table -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Repeat Offenders List</h5>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="exportOffenders()">
                        <i class="fas fa-download"></i> Export CSV
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="generateReport()">
                        <i class="fas fa-file-pdf"></i> Generate Report
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="offendersTable">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>License Number</th>
                                <th>Driver Name</th>
                                <th>Age</th>
                                <th>Gender</th>
                                <th>Violations</th>
                                <th>Total Fines</th>
                                <th>Last Violation</th>
                                <th>Risk Level</th>
                                <th>Actions</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% repeatOffenders.forEach((offender, index) => { %>
                                <tr>
                                    <td>
                                        <span class="badge bg-primary">#<%= index + 1 %></span>
                                    </td>
                                    <td>
                                        <code><%= offender.license_number %></code>
                                    </td>
                                    <td>
                                        <strong><%= offender.driver_name || 'Unknown' %></strong>
                                    </td>
                                    <td><%= offender.driver_age || 'N/A' %></td>
                                    <td><%= offender.driver_gender || 'N/A' %></td>
                                    <td>
                                        <span class="badge bg-danger fs-6"><%= offender.violation_count %></span>
                                    </td>
                                    <td>
                                        <strong class="text-danger">₹<%= offender.total_fines.toLocaleString() %></strong>
                                    </td>
                                    <td><%= offender.last_violation_date || 'N/A' %></td>
                                    <td>
                                        <% if (offender.violation_count >= 8) { %>
                                            <span class="badge bg-danger">Extreme</span>
                                        <% } else if (offender.violation_count >= 6) { %>
                                            <span class="badge bg-warning">High</span>
                                        <% } else if (offender.violation_count >= 4) { %>
                                            <span class="badge bg-orange">Medium</span>
                                        <% } else { %>
                                            <span class="badge bg-info">Low</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group" aria-label="Actions">
                                            <button class="btn btn-sm btn-outline-danger send-alert-btn" data-license="<%= offender.license_number %>" onclick="sendAlertToOwner(this)">
                                                <i class="fas fa-exclamation-circle"></i> Send Alert
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" onclick="viewOffenderDetails('<%= offender.license_number %>')">
                                            <i class="fas fa-eye"></i> Details
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Offenders Visualization -->
<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar text-warning"></i> Violations Distribution
                </h5>
            </div>
            <div class="card-body">
                <canvas id="violationsDistributionChart" width="400" height="300"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-pie text-info"></i> Gender Distribution
                </h5>
            </div>
            <div class="card-body">
                <canvas id="genderChart" width="400" height="300"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    // Chart data
    const offendersData = <%- JSON.stringify(repeatOffenders) %>;

    // Initialize charts
    document.addEventListener('DOMContentLoaded', function() {
        createViolationsDistributionChart();
        createGenderChart();
    });

    function createViolationsDistributionChart() {
        const ctx = document.getElementById('violationsDistributionChart');
        if (!ctx || !offendersData.length) return;

        // Group by violation count ranges
        const ranges = {
            '2-3': 0,
            '4-5': 0,
            '6-7': 0,
            '8+': 0
        };

        offendersData.forEach(offender => {
            if (offender.violation_count <= 3) ranges['2-3']++;
            else if (offender.violation_count <= 5) ranges['4-5']++;
            else if (offender.violation_count <= 7) ranges['6-7']++;
            else ranges['8+']++;
        });

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: Object.keys(ranges),
                datasets: [{
                    label: 'Number of Offenders',
                    data: Object.values(ranges),
                    backgroundColor: [
                        'rgba(40, 167, 69, 0.6)',
                        'rgba(255, 193, 7, 0.6)',
                        'rgba(255, 152, 0, 0.6)',
                        'rgba(220, 53, 69, 0.6)'
                    ],
                    borderColor: [
                        'rgba(40, 167, 69, 1)',
                        'rgba(255, 193, 7, 1)',
                        'rgba(255, 152, 0, 1)',
                        'rgba(220, 53, 69, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    }

    function createGenderChart() {
        const ctx = document.getElementById('genderChart');
        if (!ctx || !offendersData.length) return;

        // Count genders
        const genderCount = {};
        offendersData.forEach(offender => {
            const gender = offender.driver_gender || 'Unknown';
            genderCount[gender] = (genderCount[gender] || 0) + 1;
        });

        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: Object.keys(genderCount),
                datasets: [{
                    data: Object.values(genderCount),
                    backgroundColor: [
                        'rgba(54, 162, 235, 0.6)',
                        'rgba(255, 99, 132, 0.6)',
                        'rgba(255, 205, 86, 0.6)',
                        'rgba(75, 192, 192, 0.6)',
                        'rgba(153, 102, 255, 0.6)'
                    ],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    }

    function exportOffenders() {
        const csvContent = [
            ['Rank', 'License Number', 'Driver Name', 'Age', 'Gender', 'Violations', 'Total Fines', 'Last Violation', 'Risk Level'].join(','),
            ...offendersData.map((offender, i) => {
                let riskLevel = 'Low';
                if (offender.violation_count >= 8) riskLevel = 'Extreme';
                else if (offender.violation_count >= 6) riskLevel = 'High';
                else if (offender.violation_count >= 4) riskLevel = 'Medium';

                return [
                    i + 1,
                    `"${offender.license_number}"`,
                    `"${offender.driver_name || ''}"`,
                    offender.driver_age || '',
                    offender.driver_gender || '',
                    offender.violation_count,
                    offender.total_fines,
                    offender.last_violation_date || '',
                    riskLevel
                ].join(',');
            })
        ].join('\n');

        const blob = new Blob([csvContent], { type: 'text/csv' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'repeat_offenders.csv';
        a.click();
        window.URL.revokeObjectURL(url);
    }

    function generateReport() {
        alert('Report generation feature would be implemented here. In a production app, this might generate a PDF report with detailed analysis.');
    }

    function viewOffenderDetails(licenseNumber) {
        // This would ideally show all violations for this license number
        // For now, we'll just show an alert
        const offender = offendersData.find(o => o.license_number === licenseNumber);
        if (offender) {
            alert(`Driver ${offender.driver_name || 'Unknown'} has ${offender.violation_count} violations totaling ₹${offender.total_fines.toLocaleString()}.`);
        }
    }

    // Toast helper for alerts
    function showToast(message, type='success') {
        let container = document.getElementById('toast-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'position-fixed top-0 end-0 p-3';
            document.body.appendChild(container);
        }
        const wrapper = document.createElement('div');
        wrapper.innerHTML = `
            <div class="toast align-items-center text-bg-${type === 'success' ? 'success' : 'danger'} border-0" role="alert" aria-live="assertive" aria-atomic="true">
              <div class="d-flex">
                <div class="toast-body">${message}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
              </div>
            </div>`;
        const toastEl = wrapper.firstElementChild;
        container.appendChild(toastEl);
        const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
        toast.show();
    }

    async function sendAlertToOwner(btn) {
        const license = btn.getAttribute('data-license');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending';
        try {
            const resp = await fetch('http://localhost:8000/api/alerts/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ source: 'repeat-offenders', license_number: license })
            });
            const data = await resp.json();
            if (data.success) {
                showToast('Alert sent successfully!');
            } else {
                showToast('Alert processed with issues', 'danger');
                console.error('Alert errors:', data.errors);
            }
        } catch (e) {
            showToast('Alert failed. Check console.', 'danger');
            console.error(e);
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }

    // Update range value display
    document.getElementById('min_violations').addEventListener('input', function() {
        this.nextElementSibling.querySelector('.fw-bold').textContent = this.value;
    });
</script>
